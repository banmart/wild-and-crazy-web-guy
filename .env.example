# Resend API Key (starts with re_...)
RESEND_API_KEY=re_your_api_key_here

# Sender address (use onboarding@resend.dev until your custom domain DNS is verified in Resend)
RESEND_FROM_EMAIL=Wild & Crazy SEO <onboarding@resend.dev>

# Recipient address where booking inquiries should be delivered
RESEND_TO_EMAIL=banmart@gmail.com

# Upstash Redis, for article view counts.
# Add the Upstash integration in the Vercel dashboard and these are injected automatically.
# Without them, view counts fall back to a local JSON file that only works in dev.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here
