---
interface Props {
  row: string;
  seat: string;
  film: string;
  tagline: string;
  price: string;
  items: string[];
  feature?: boolean;
  soldOut?: boolean;
}

const { row, seat, film, tagline, price, items, feature = false, soldOut = false } = Astro.props;

// Level meter dots for brutalist tech indicator
const getLevelMeter = (tierName: string) => {
  if (tierName.includes('The Jerk')) return '■□□';
  if (tierName.includes('Roxanne')) return '■■□';
  return '■■■';
};
---

<article class:list={['ticket', 'reveal', { feature }]}>
  {soldOut && <div class="sold-out">Sold Out</div>}

  <div class="ticket-top">
    <div class="ticket-row-group">
      <span class="ticket-row">{row}</span>
      <span class="tier-meter" aria-hidden="true">{getLevelMeter(film)}</span>
    </div>
    <span class="ticket-seat">{seat}</span>
  </div>

  <div class="ticket-body">
    <h3 class="film">{film}</h3>
    <p class="tagline">{tagline}</p>
    <div class="price-badge">
      <span class="price-label">INVESTMENT</span>
      <p class="price">{price}</p>
    </div>
    <ul>
      {items.map((item) => <li>{item}</li>)}
    </ul>
    <a href="/contact" class="ticket-btn">
      <span>Reserve Tier</span>
      <span class="btn-arrow" aria-hidden="true">→</span>
      <span class="sr-only">, {film}</span>
    </a>
  </div>
</article>

<style>
  .ticket-row-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tier-meter {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 2px;
    opacity: 0.8;
  }

  .price-badge {
    margin-top: 16px;
    padding: 10px 12px;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ticket.feature .price-badge {
    background: var(--surface-dark-subtle);
    border-color: var(--line-dark);
  }

  .price-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .ticket.feature .price-label {
    color: var(--text-inverse-muted);
  }

  .price {
    margin-top: 0 !important;
    font-size: 20px !important;
    line-height: 1.1;
  }

  .btn-arrow {
    transition: transform 0.15s ease;
  }

  .ticket-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>
