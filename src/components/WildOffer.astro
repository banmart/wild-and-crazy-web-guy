---
import { wildOffer } from '../data/site';
---

<section class="wild-offer-section" id="wild-offer">
  <div class="wrap">
    <div class="brutal-offer-board reveal">
      <!-- High-Contrast Top Tag -->
      <div class="board-top-tag">
        <div class="tag-left">
          <span class="dot-matrix" aria-hidden="true">
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
            <span></span><span></span><span></span>
          </span>
          <span class="tag-text">SPECIAL ATTRACTION · 100% FREE EXTRAS</span>
        </div>
        <div class="tag-status">
          <span class="status-indicator" aria-hidden="true">■■■■■</span>
          <span class="status-text">INCLUDED</span>
        </div>
      </div>

      <!-- Header -->
      <div class="offer-header">
        <p class="eyebrow offer-eyebrow">{wildOffer.eyebrow}</p>
        <h2 class="offer-heading">
          FREE <span class="accent">W/ NEW WEBSITE DEVELOPMENT &amp; DESIGN</span>
        </h2>
        <p class="offer-subtitle">
          {wildOffer.subtitle}
        </p>
        <p class="offer-note">
          {wildOffer.accountantNote}
        </p>
      </div>

      <!-- The 6 Offer Cards Grid -->
      <div class="offer-grid">
        {
          wildOffer.items.map((item, idx) => (
            <article class="offer-card">
              <div class="offer-card-top">
                <div class="offer-icon-wrapper" aria-hidden="true">
                  <span class="offer-icon">{item.icon}</span>
                </div>
                <div class="offer-badge-group">
                  <span class="offer-pill">{item.badge}</span>
                  <span class="offer-num">0{idx + 1}</span>
                </div>
              </div>

              <div class="offer-card-body">
                <h3 class="offer-item-title">{item.title}</h3>
                <p class="offer-item-tagline">{item.tagline}</p>
                <p class="offer-item-desc">{item.description}</p>
              </div>

              <div class="offer-card-footer">
                <span class="card-status-label">STATUS</span>
                <span class="card-status-val">FREE / $0.00 →</span>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Value Total Bar & CTA -->
      <div class="offer-summary">
        <div class="value-comparison">
          <div class="value-box">
            <span class="value-title">MARKET COST OF EXTRAS</span>
            <span class="value-amount struck">{wildOffer.marketValue}</span>
          </div>
          <div class="value-divider" aria-hidden="true">/</div>
          <div class="value-box highlight">
            <span class="value-title">YOUR COST WITH SITE BUILD</span>
            <span class="value-amount free">{wildOffer.yourPrice}</span>
          </div>
        </div>

        <div class="cta-wrap">
          <a href={wildOffer.ctaHref} class="ticket-btn large">
            <span>{wildOffer.ctaText}</span>
            <span class="btn-arrow" aria-hidden="true">→</span>
          </a>
        </div>

        <p class="offer-disclaimer">
          {wildOffer.disclaimer}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .wild-offer-section {
    padding: 60px 0 48px;
    position: relative;
    background: var(--bg-subtle);
    border-top: 2px solid var(--border);
    border-bottom: 2px solid var(--border);
  }

  @media (min-width: 768px) {
    .wild-offer-section {
      padding: 80px 0 68px;
    }
  }

  .brutal-offer-board {
    position: relative;
    background: var(--bg);
    border: 2px solid var(--border);
    box-shadow: var(--shadow-brutal-lg);
    padding: 24px 20px 32px;
  }

  @media (min-width: 768px) {
    .brutal-offer-board {
      padding: 44px 36px 44px;
    }
  }

  /* Board Top Tag */
  .board-top-tag {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 18px;
    border-bottom: 2px solid var(--border);
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 12px;
  }

  .tag-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .tag-text {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .tag-status {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .status-indicator {
    letter-spacing: 2px;
    font-size: 9px;
  }

  /* Header */
  .offer-header {
    max-width: 760px;
    margin-bottom: 36px;
  }

  .offer-eyebrow {
    margin-bottom: 10px;
  }

  .offer-heading {
    font-size: clamp(36px, 6.5vw, 64px);
    line-height: 0.95;
    margin-bottom: 14px;
  }

  .offer-heading .accent {
    display: block;
    color: var(--ink);
  }

  .offer-subtitle {
    font-size: 17px;
    color: var(--ink-soft);
    line-height: 1.55;
    margin-bottom: 8px;
  }

  .offer-note {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--ink-muted);
  }

  /* Cards Grid */
  .offer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-bottom: 40px;
  }

  @media (min-width: 680px) {
    .offer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1020px) {
    .offer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Individual Card */
  .offer-card {
    background: var(--bg);
    border: 2px solid var(--border);
    box-shadow: var(--shadow-brutal);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .offer-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: var(--shadow-brutal-hover);
  }

  .offer-card-top {
    padding: 16px 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
  }

  .offer-icon-wrapper {
    width: 36px;
    height: 36px;
    background: var(--surface-dark);
    color: var(--text-inverse);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
  }

  .offer-icon {
    font-size: 18px;
    line-height: 1;
  }

  .offer-badge-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .offer-pill {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.12em;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--surface-dark);
    color: var(--text-inverse);
    padding: 4px 8px;
  }

  .offer-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    color: var(--ink-muted);
  }

  .offer-card-body {
    padding: 20px 18px 22px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .offer-item-title {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink);
    line-height: 0.95;
    margin-bottom: 8px;
  }

  .offer-item-tagline {
    font-size: 13.5px;
    color: var(--ink-muted);
    line-height: 1.45;
    margin-bottom: 12px;
  }

  .offer-item-desc {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--ink-soft);
    margin-top: auto;
  }

  .offer-card-footer {
    padding: 10px 18px;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-subtle);
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .card-status-label {
    color: var(--ink-muted);
  }

  .card-status-val {
    color: var(--ink);
  }

  /* Bottom Summary Bar */
  .offer-summary {
    border-top: 2px solid var(--border);
    padding-top: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .value-comparison {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
    background: var(--bg-subtle);
    border: 2px solid var(--border);
    box-shadow: var(--shadow-brutal);
    padding: 16px 24px;
    width: 100%;
    max-width: 520px;
  }

  .value-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .value-title {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .value-amount {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 0.95;
  }

  .value-amount.struck {
    color: var(--ink-muted);
    text-decoration: line-through;
  }

  .value-amount.free {
    color: var(--ink);
  }

  .value-divider {
    font-family: var(--font-display);
    font-size: 24px;
    color: var(--ink-muted);
  }

  .cta-wrap {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .cta-wrap .ticket-btn {
    width: 100%;
    max-width: 440px;
  }

  .btn-arrow {
    transition: transform 0.15s ease;
  }

  .ticket-btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  .offer-disclaimer {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
    max-width: 62ch;
    line-height: 1.6;
    margin: 0 auto;
  }
</style>
