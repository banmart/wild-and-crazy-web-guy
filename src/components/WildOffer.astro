---
import { wildOffer } from '../data/site';
---

<section class="wild-offer-section" id="wild-offer">
  <div class="wrap">
    <div class="marquee-board reveal">
      <!-- Theatrical Corner Flourishes -->
      <div class="corner-flourish tl" aria-hidden="true">✦</div>
      <div class="corner-flourish tr" aria-hidden="true">✦</div>
      <div class="corner-flourish bl" aria-hidden="true">✦</div>
      <div class="corner-flourish br" aria-hidden="true">✦</div>

      <!-- Vintage Stamp Badge -->
      <div class="offer-stamp" aria-hidden="true">
        <span class="stamp-border">
          <span class="stamp-small">LIMITED TIME</span>
          <strong class="stamp-main">100% FREE</strong>
          <span class="stamp-sub">EXTRAS WITH BUILD</span>
        </span>
      </div>

      <!-- Header -->
      <div class="offer-header">
        <p class="eyebrow offer-eyebrow">{wildOffer.eyebrow}</p>
        <h2 class="offer-heading">
          FREE <span class="accent">w/ New Website Development &amp; Design</span>
        </h2>
        <p class="offer-subtitle">
          {wildOffer.subtitle}
        </p>
        <p class="offer-note">
          <em>{wildOffer.accountantNote}</em>
        </p>
      </div>

      <!-- The 6 Offer Cards Grid -->
      <div class="offer-grid">
        {
          wildOffer.items.map((item) => (
            <article class="offer-card">
              <div class="offer-card-top">
                <div class="offer-icon-wrapper" aria-hidden="true">
                  <span class="offer-icon">{item.icon}</span>
                </div>
                <span class="offer-pill">{item.badge}</span>
              </div>

              <div class="card-perf" aria-hidden="true"></div>

              <div class="offer-card-body">
                <h3 class="offer-item-title">{item.title}</h3>
                <p class="offer-item-tagline">{item.tagline}</p>
                <p class="offer-item-desc">{item.description}</p>
              </div>
            </article>
          ))
        }
      </div>

      <!-- Value Total Bar & CTA -->
      <div class="offer-summary">
        <div class="value-comparison">
          <div class="value-box">
            <span class="value-title">Typical Software Cost</span>
            <span class="value-amount struck">{wildOffer.marketValue}</span>
          </div>
          <div class="value-vs" aria-hidden="true">⚡</div>
          <div class="value-box highlight">
            <span class="value-title">Your Price With Site Build</span>
            <span class="value-amount free">{wildOffer.yourPrice}</span>
          </div>
        </div>

        <div class="cta-wrap">
          <a href={wildOffer.ctaHref} class="ticket-btn wild-cta">
            {wildOffer.ctaText}
          </a>
        </div>

        <p class="offer-disclaimer">
          {wildOffer.disclaimer}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .wild-offer-section {
    padding: 84px 0 64px;
    position: relative;
  }

  .marquee-board {
    position: relative;
    background: var(--paper-light);
    border: 3px solid var(--ink);
    box-shadow: 10px 10px 0 var(--burgundy);
    padding: 60px 48px 48px;
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .marquee-board {
      padding: 42px 22px 32px;
      box-shadow: 6px 6px 0 var(--burgundy);
    }
  }

  /* Decorative corner flourishes */
  .corner-flourish {
    position: absolute;
    font-size: 18px;
    color: var(--gold);
    line-height: 1;
    pointer-events: none;
    user-select: none;
  }
  .corner-flourish.tl { top: 12px; left: 14px; }
  .corner-flourish.tr { top: 12px; right: 14px; }
  .corner-flourish.bl { bottom: 12px; left: 14px; }
  .corner-flourish.br { bottom: 12px; right: 14px; }

  /* Vintage Stamped Badge */
  .offer-stamp {
    position: absolute;
    top: 24px;
    right: 28px;
    z-index: 2;
    transform: rotate(5deg);
    transition: transform 0.2s ease;
  }
  .offer-stamp:hover {
    transform: rotate(2deg) scale(1.05);
  }
  @media (max-width: 820px) {
    .offer-stamp {
      position: static;
      display: inline-block;
      margin-bottom: 24px;
      transform: rotate(-2deg);
    }
  }
  .stamp-border {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border: 3px dashed var(--burgundy);
    background: rgba(122, 31, 43, 0.08);
    padding: 8px 16px;
    border-radius: 4px;
    text-align: center;
  }
  .stamp-small {
    font-family: 'Space Mono', monospace;
    font-size: 9.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--burgundy);
  }
  .stamp-main {
    font-family: 'Alfa Slab One', serif;
    font-size: 20px;
    color: var(--burgundy);
    line-height: 1.1;
    margin: 2px 0;
  }
  .stamp-sub {
    font-family: 'Space Mono', monospace;
    font-size: 8.5px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* Header */
  .offer-header {
    max-width: 760px;
    margin-bottom: 44px;
  }
  .offer-eyebrow {
    margin-bottom: 12px;
  }
  .offer-heading {
    font-size: clamp(28px, 4.2vw, 44px);
    line-height: 1.12;
    margin-bottom: 16px;
  }
  .offer-heading .accent {
    color: var(--burgundy);
    display: inline;
  }
  .offer-subtitle {
    font-size: 18px;
    color: var(--ink-soft);
    line-height: 1.6;
    margin-bottom: 8px;
  }
  .offer-note {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 15.5px;
    color: var(--burgundy);
  }

  /* Cards Grid */
  .offer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-bottom: 48px;
  }
  @media (max-width: 960px) {
    .offer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .offer-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  /* Individual Card */
  .offer-card {
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--line);
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .offer-card:hover {
    transform: translate(-3px, -3px);
    box-shadow: 7px 7px 0 var(--burgundy);
    border-color: var(--burgundy);
  }

  .offer-card-top {
    padding: 16px 18px 12px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: rgba(32, 21, 18, 0.03);
  }
  .offer-icon-wrapper {
    width: 38px;
    height: 38px;
    background: var(--paper-light);
    border: 1.5px solid var(--ink);
    box-shadow: 2px 2px 0 var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }
  .offer-icon {
    font-size: 20px;
    line-height: 1;
  }
  .offer-pill {
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    font-weight: 700;
    text-transform: uppercase;
    background: var(--burgundy);
    color: var(--gold-light);
    padding: 4px 8px;
    border: 1px solid var(--ink);
    box-shadow: 2px 2px 0 var(--ink);
  }

  /* Perforation Line */
  .card-perf {
    position: relative;
    border-top: 2px dashed var(--line);
  }
  .card-perf::before,
  .card-perf::after {
    content: '';
    position: absolute;
    top: -7px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--paper-light);
    border: 1.5px solid var(--ink);
  }
  .card-perf::before { left: -8px; }
  .card-perf::after { right: -8px; }

  .offer-card-body {
    padding: 20px 20px 24px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .offer-item-title {
    font-family: 'Alfa Slab One', serif;
    font-size: 19px;
    color: var(--burgundy);
    line-height: 1.15;
    margin-bottom: 8px;
  }
  .offer-item-tagline {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 14.5px;
    color: var(--ink-soft);
    line-height: 1.4;
    margin-bottom: 12px;
  }
  .offer-item-desc {
    font-size: 14px;
    line-height: 1.6;
    color: var(--ink-soft);
    margin-top: auto;
  }

  /* Bottom Summary Bar */
  .offer-summary {
    border-top: 2px solid var(--ink);
    padding-top: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .value-comparison {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    flex-wrap: wrap;
    background: var(--paper);
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--line);
    padding: 16px 28px;
  }
  .value-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }
  .value-title {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .value-amount {
    font-family: 'Alfa Slab One', serif;
    font-size: 24px;
  }
  .value-amount.struck {
    color: var(--ink-soft);
    text-decoration: line-through;
    text-decoration-color: var(--burgundy);
    text-decoration-thickness: 2px;
    opacity: 0.7;
  }
  .value-amount.free {
    color: var(--burgundy);
  }
  .value-vs {
    font-size: 18px;
    color: var(--gold);
  }

  .wild-cta {
    font-size: 14px;
    padding: 14px 28px;
    background: var(--burgundy);
    color: var(--gold-light);
    box-shadow: 4px 4px 0 var(--ink);
  }
  .wild-cta:hover {
    box-shadow: 6px 6px 0 var(--ink);
  }

  .offer-disclaimer {
    font-family: 'Space Mono', monospace;
    font-size: 11.5px;
    color: var(--ink-soft);
    opacity: 0.85;
    max-width: 68ch;
    line-height: 1.7;
    margin: 0 auto;
  }
</style>
