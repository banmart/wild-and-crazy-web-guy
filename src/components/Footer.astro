---
import { nav, site } from '../data/site';
const year = new Date().getFullYear();
---

<footer>
  <div class="wrap">
    <nav class="footer-nav" aria-label="Footer">
      <a href="/">Home</a>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/privacy">Privacy Policy</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </nav>

    <div class="credits">
      Written, optimized &amp; coded by <strong>Steve Martin</strong> (the SEO one)<br />
      AI search strategy by <strong>Steve Martin</strong> (still him)<br />
      Not endorsed by <strong>Steve Martin</strong> (the other one)
    </div>

    <div class="copyright">
      © {year} {site.brand}. All rights reserved. All banjos rented.<br />
      This site scores 100 on its own audit. It would be embarrassing otherwise.
    </div>
  </div>
</footer>
