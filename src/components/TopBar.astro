---
import { Image } from 'astro:assets';
import { nav, site } from '../data/site';
import logoImg from '../assets/steve-profile.webp';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path === `${href}/`;
---

<header class="topbar">
  <div class="topbar-inner">
    <a href="/" class="wordmark">
      <Image
        src={logoImg}
        alt=""
        width={38}
        height={38}
        loading="eager"
        class="logo-mark"
        aria-hidden="true"
      />
      <div class="wordmark-text">
        <span class="wordmark-title">STEVE MARTIN</span>
        <small>WILD &amp; CRAZY SEO</small>
      </div>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="topbar-actions">
      <a href={site.bookingUrl} class="ticket-btn small">Book Free Consult →</a>

      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span class="dot-matrix" aria-hidden="true">
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
          <span></span><span></span><span></span>
        </span>
        <span class="toggle-text">Menu</span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" data-open="false" aria-label="Mobile">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          <span>{item.label}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))
    }
    <a href={site.bookingUrl} class="mobile-cta">
      <span>Book Free Consult</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  </nav>
</header>

<style>
  .topbar-actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .nav-toggle {
    display: none;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 820px) {
    .nav-toggle {
      display: inline-flex;
    }
  }

  .mobile-cta {
    background: var(--surface-dark);
    color: var(--text-inverse) !important;
    padding: 14px 12px !important;
    margin-top: 10px;
  }
</style>
