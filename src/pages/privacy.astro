---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';

const lastUpdated = 'August 15, 2026';

const sections = [
  { id: 'summary', title: 'The Short Version' },
  { id: 'who-we-are', title: 'Who We Are' },
  { id: 'information-collected', title: 'Information We Collect' },
  { id: 'analytics-clarity', title: 'Microsoft Clarity & Analytics' },
  { id: 'cookies', title: 'Cookies & Tracking' },
  { id: 'third-parties', title: 'Third-Party Services' },
  { id: 'data-retention-security', title: 'Data Retention & Security' },
  { id: 'your-rights', title: 'Your Privacy Rights' },
  { id: 'contact', title: 'Questions & Contact' },
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${Astro.site?.href}privacy/`,
  name: 'Privacy Policy | Wild & Crazy SEO',
  description:
    'Privacy Policy for Wild & Crazy SEO (Steve Martin). Learn how we collect, use, and protect your information, including our use of Microsoft Clarity.',
  url: `${Astro.site?.href}privacy/`,
};
---

<BaseLayout
  title="Privacy Policy | Wild & Crazy SEO, Steve Martin"
  description="Plain-English privacy policy for Wild & Crazy SEO and Steve Martin. Clear details on data collection, Microsoft Clarity tracking, cookies, and your privacy rights."
  schema={schema}
>
  <section class="hero">
    <div class="wrap">
      <div class="ribbon">
        <strong>Full Transparency</strong>
        No selling data · No fine-print traps
      </div>
      <p class="hero-eyebrow eyebrow">The Fine Print · Backstage Rules</p>
      <h1>Privacy<br /><span class="accent">Policy.</span></h1>
      <p class="hero-sub">
        Plain English, zero corporate fog. What data this site collects, why it is collected,
        how tracking tools (like Microsoft Clarity) work, and how your information is protected.
      </p>
      <div class="meta-date">
        <span>Last Updated: <strong>{lastUpdated}</strong></span>
      </div>
    </div>
  </section>

  <div class="bulb-strip" aria-hidden="true"></div>

  <section class="playbill">
    <div class="wrap">
      <div class="policy-grid">
        <aside class="toc" aria-label="Privacy Policy Sections">
          <p class="toc-title">The Set List</p>
          <ol>
            {
              sections.map((sec) => (
                <li>
                  <a href={`#${sec.id}`}>{sec.title}</a>
                </li>
              ))
            }
          </ol>
        </aside>

        <div class="policy-body reveal">
          <!-- 1. Summary -->
          <div id="summary" class="policy-card summary-card">
            <span class="card-tag">TL;DR</span>
            <h2>1. The Short Version</h2>
            <p>
              I respect your time and your privacy. I run a small, independent SEO consulting practice,
              not a data broker. Here is the bottom line:
            </p>
            <ul class="bullet-list">
              <li><strong>We do not sell, rent, or trade your personal data.</strong> Ever.</li>
              <li>
                <strong>Form submissions</strong> (name, email, website, details) are only used to respond to your inquiries, schedule consults, and deliver audits.
              </li>
              <li>
                <strong>We use Microsoft Clarity</strong> to understand how visitors navigate the site (heatmaps, scrolls, clicks) so we can fix UX bugs and make the site better.
              </li>
              <li>
                <strong>You have full control.</strong> You can request a copy or deletion of your information anytime by sending a quick email.
              </li>
            </ul>
          </div>

          <!-- 2. Who We Are -->
          <section id="who-we-are" class="policy-section">
            <h2>2. Who We Are</h2>
            <p>
              This website (<em>wildandcrazyseo.com</em> / Steve Martin SEO) is owned and operated by <strong>Steve Martin</strong> dba <strong>{site.brand}</strong>.
            </p>
            <div class="info-box">
              <p><strong>Contact Email:</strong> <a href={`mailto:${site.email}`}>{site.email}</a></p>
              <p><strong>Phone:</strong> <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
              <p><strong>Location:</strong> {site.location}</p>
            </div>
          </section>

          <!-- 3. Information We Collect -->
          <section id="information-collected" class="policy-section">
            <h2>3. Information We Collect</h2>
            <p>We collect information in two ways: directly from you when you submit a form, and automatically when you browse the site.</p>

            <h3>A. Information You Provide Directly</h3>
            <p>
              When you fill out the contact or audit request form on this website, we collect:
            </p>
            <ul class="bullet-list">
              <li><strong>Name:</strong> To address you like a human being.</li>
              <li><strong>Email Address:</strong> To reply to your inquiry and send you audit notes.</li>
              <li><strong>Business Name &amp; Website URL:</strong> To inspect your site's SEO, speed, and visibility prior to our call.</li>
              <li><strong>Phone Number (optional):</strong> If you prefer a phone conversation.</li>
              <li><strong>Notes &amp; Project Description:</strong> Whatever context you share regarding your marketing, traffic, or technical challenges.</li>
            </ul>

            <h3>B. Technical Data &amp; Server Logs</h3>
            <p>
              Like almost every modern website, our hosting provider (Vercel) automatically logs basic technical request data when your browser requests a page. This includes your IP address, browser type, operating system, referring URL, and date/timestamp. This data is used solely for system administration, performance monitoring, and DDOS mitigation.
            </p>
          </section>

          <!-- 4. Microsoft Clarity & Analytics -->
          <section id="analytics-clarity" class="policy-section">
            <h2>4. Microsoft Clarity &amp; Analytics</h2>
            <p>
              We partner with <strong>Microsoft Clarity</strong> to capture how you use and interact with our website through behavioral metrics, heatmaps, and session replay to improve and market our products/services.
            </p>
            <p>
              Website usage data is captured using first and third-party cookies and other tracking technologies to determine the popularity of content, discover broken buttons or navigation bugs, and analyze overall site activity. Additionally, we use this information for site optimization and security purposes.
            </p>
            <p>
              Clarity automatically masks sensitive keystrokes and personal information entered into form inputs to safeguard your privacy.
            </p>
            <div class="notice-box">
              <p>
                For more details on how Microsoft collects and processes your data, please review the <a href="https://privacy.microsoft.com/en-us/privacystatement" target="_blank" rel="noopener noreferrer">Microsoft Privacy Statement</a> and <a href="https://clarity.microsoft.com/terms" target="_blank" rel="noopener noreferrer">Microsoft Clarity Terms of Use</a>.
              </p>
            </div>
          </section>

          <!-- 5. Cookies -->
          <section id="cookies" class="policy-section">
            <h2>5. Cookies &amp; Tracking Technologies</h2>
            <p>
              Cookies are small text files stored on your device by your web browser. We use cookies and similar technologies for the following purposes:
            </p>
            <ul class="bullet-list">
              <li><strong>Essential / Functional:</strong> To keep the website running securely and reliably.</li>
              <li><strong>Analytics / Clarity Cookies:</strong> Set by Microsoft Clarity to record unique anonymous session identifiers and track user journeys across pages.</li>
            </ul>
            <p>
              <strong>Managing Cookies:</strong> You can configure your browser to reject all cookies or notify you when a cookie is sent. Most browsers also allow you to delete cookies at any time. Note that basic site functionality will remain intact even if cookies are disabled.
            </p>
          </section>

          <!-- 6. Third-Party Services -->
          <section id="third-parties" class="policy-section">
            <h2>6. Third-Party Service Providers</h2>
            <p>
              We rely on trusted third-party service providers to power specific functions of this website:
            </p>
            <div class="service-table-wrap">
              <table class="service-table">
                <thead>
                  <tr>
                    <th>Provider</th>
                    <th>Purpose</th>
                    <th>Privacy Link</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong>Vercel</strong></td>
                    <td>Hosting, CDN, and Serverless API processing</td>
                    <td><a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">Vercel Privacy</a></td>
                  </tr>
                  <tr>
                    <td><strong>Resend</strong></td>
                    <td>Transactional email delivery for contact form submissions</td>
                    <td><a href="https://resend.com/legal/privacy-policy" target="_blank" rel="noopener noreferrer">Resend Privacy</a></td>
                  </tr>
                  <tr>
                    <td><strong>Microsoft Clarity</strong></td>
                    <td>Session replay, heatmaps, and user interaction analytics</td>
                    <td><a href="https://privacy.microsoft.com/privacystatement" target="_blank" rel="noopener noreferrer">Microsoft Privacy</a></td>
                  </tr>
                  <tr>
                    <td><strong>Google Fonts</strong></td>
                    <td>Typography and web font stylesheets</td>
                    <td><a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">Google Privacy</a></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </section>

          <!-- 7. Data Retention & Security -->
          <section id="data-retention-security" class="policy-section">
            <h2>7. Data Retention &amp; Security</h2>
            <p>
              We only retain personal information for as long as necessary to fulfill the purposes for which it was collected, including responding to inquiries, delivering ongoing consulting services, and complying with legal, tax, or accounting requirements.
            </p>
            <p>
              All traffic between your browser and this site is encrypted using modern <strong>TLS (HTTPS)</strong>. While no internet transmission is 100% immune from vulnerabilities, we implement industry-standard practices to protect your data from unauthorized access or disclosure.
            </p>
          </section>

          <!-- 8. Your Rights -->
          <section id="your-rights" class="policy-section">
            <h2>8. Your Privacy Rights</h2>
            <p>
              Depending on your location (including under GDPR, CCPA/CPRA, and other regional privacy regulations), you have rights regarding your personal information:
            </p>
            <ul class="bullet-list">
              <li><strong>Right to Know / Access:</strong> You can ask what personal details we have stored about you.</li>
              <li><strong>Right to Rectification:</strong> You can ask us to update or correct any inaccuracies.</li>
              <li><strong>Right to Erasure:</strong> You can ask us to permanently delete your contact history.</li>
              <li><strong>Right to Non-Discrimination:</strong> We will never deny services or charge different prices for exercising your privacy rights.</li>
            </ul>
            <p>
              To submit a request, simply email us at <a href={`mailto:${site.email}`}>{site.email}</a>. We respond to all verified requests promptly.
            </p>
          </section>

          <!-- 9. Contact -->
          <section id="contact" class="policy-section">
            <h2>9. Questions &amp; Contact Information</h2>
            <p>
              If you have any questions, comments, or concerns regarding this Privacy Policy or our data practices, please reach out directly:
            </p>
            <div class="contact-card">
              <p class="brand-line"><strong>{site.brand}</strong> · Steve Martin</p>
              <p>Email: <a href={`mailto:${site.email}`}>{site.email}</a></p>
              <p>Phone: <a href={`tel:${site.phoneHref}`}>{site.phone}</a></p>
              <p>Online: <a href="/contact">wildandcrazyseo.com/contact</a></p>
            </div>
          </section>
        </div>
      </div>
    </div>
  </section>

  <section class="cta-band">
    <div class="wrap">
      <span class="eyebrow">Ready For Results?</span>
      <h2>Let's talk about your search traffic.</h2>
      <p>Free 20-minute consult, no contracts, and an honest audit of what's holding your site back.</p>
      <a href="/contact" class="ticket-btn">Book Your Free Audit →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .meta-date {
    margin-top: 24px;
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
  .meta-date strong {
    color: var(--burgundy);
  }

  .policy-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 56px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .policy-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .toc {
    position: sticky;
    top: 110px;
    border-left: 2px solid var(--burgundy);
    padding-left: 18px;
  }
  @media (max-width: 900px) {
    .toc {
      position: static;
      background: var(--paper-light);
      border: 2px solid var(--ink);
      box-shadow: 5px 5px 0 var(--line);
      padding: 20px 22px;
    }
  }
  .toc-title {
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--burgundy);
    margin-bottom: 14px;
    font-weight: 700;
  }
  .toc ol {
    list-style: none;
    counter-reset: toc;
  }
  .toc li {
    counter-increment: toc;
    margin-bottom: 11px;
    font-size: 13.5px;
    line-height: 1.4;
  }
  .toc li::before {
    content: counter(toc, decimal) '. ';
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    color: var(--gold);
  }
  .toc a {
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
  }
  .toc a:hover,
  .toc a:focus-visible {
    color: var(--burgundy);
    border-color: var(--burgundy);
    outline: none;
  }

  /* ---- Content Styles ---- */
  .policy-body {
    max-width: 72ch;
  }

  .policy-card {
    background: var(--paper-light);
    border: 2px solid var(--ink);
    box-shadow: 6px 6px 0 var(--line);
    padding: 36px 40px;
    margin-bottom: 48px;
    position: relative;
  }
  @media (max-width: 600px) {
    .policy-card {
      padding: 24px 20px;
    }
  }

  .card-tag {
    position: absolute;
    top: -12px;
    right: 20px;
    background: var(--burgundy);
    color: var(--gold-light);
    font-family: 'Space Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 4px 10px;
    border: 1px solid var(--ink);
  }

  .policy-section {
    margin-bottom: 44px;
    padding-bottom: 40px;
    border-bottom: 1px dashed var(--line);
  }
  .policy-section:last-of-type {
    border-bottom: none;
  }

  .policy-body h2 {
    font-size: clamp(24px, 3.2vw, 32px);
    color: var(--burgundy);
    margin-bottom: 16px;
    line-height: 1.15;
  }

  .policy-body h3 {
    font-size: 19px;
    color: var(--ink);
    margin-top: 28px;
    margin-bottom: 10px;
  }

  .policy-body p {
    font-size: 16.5px;
    line-height: 1.75;
    color: var(--ink-soft);
    margin-bottom: 16px;
  }

  .policy-body a {
    color: var(--burgundy);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .policy-body a:hover {
    color: var(--ink);
  }

  .bullet-list {
    margin: 16px 0 24px 20px;
    list-style-type: square;
    color: var(--burgundy);
  }
  .bullet-list li {
    font-size: 16px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 10px;
    padding-left: 4px;
  }

  .info-box,
  .notice-box,
  .contact-card {
    background: var(--paper-light);
    border: 1px solid var(--line);
    border-left: 4px solid var(--burgundy);
    padding: 20px 24px;
    margin: 20px 0;
    box-shadow: 3px 3px 0 rgba(32, 21, 18, 0.06);
  }

  .notice-box {
    border-left-color: var(--gold);
    background: #faf6ea;
  }

  .info-box p,
  .notice-box p,
  .contact-card p {
    margin-bottom: 8px;
    font-size: 15px;
  }
  .info-box p:last-child,
  .notice-box p:last-child,
  .contact-card p:last-child {
    margin-bottom: 0;
  }

  .brand-line {
    font-family: 'Space Mono', monospace;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--burgundy);
    margin-bottom: 10px !important;
  }

  /* ---- Table ---- */
  .service-table-wrap {
    overflow-x: auto;
    margin: 24px 0;
    border: 2px solid var(--ink);
    box-shadow: 4px 4px 0 var(--line);
  }
  .service-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
    text-align: left;
    background: var(--paper-light);
  }
  .service-table th {
    background: var(--ink);
    color: var(--paper-light);
    font-family: 'Space Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 12px 16px;
  }
  .service-table td {
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-soft);
  }
  .service-table tr:last-child td {
    border-bottom: none;
  }
  .service-table tr:nth-child(even) td {
    background: rgba(32, 21, 18, 0.02);
  }
</style>
