---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// pubDate is a bare YYYY-MM-DD, so it parses as UTC midnight. Format in UTC too,
// or every post renders a day early for anyone west of Greenwich.
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });

const canonical = new URL(Astro.url.pathname, Astro.site).href;

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      keywords: post.data.tags.join(', '),
      articleSection: post.data.tags[0],
      inLanguage: 'en-US',
      image: new URL('/og-image.jpg', Astro.site).href,
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
      author: {
        '@type': 'Person',
        '@id': `${Astro.site?.href}#steve`,
        name: 'Steve Martin',
        jobTitle: 'SEO Consultant',
        url: new URL('/about/', Astro.site).href,
      },
      publisher: {
        '@type': 'Organization',
        name: site.brand,
        logo: {
          '@type': 'ImageObject',
          url: new URL('/icon-512.png', Astro.site).href,
        },
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site?.href },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'The Green Room',
          item: new URL('/blog/', Astro.site).href,
        },
        { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
      ],
    },
  ],
};

// Only h2s; h3s make the bill too long.
const toc = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={`${post.data.title} | Steve Martin`}
  description={post.data.description}
  ogType="article"
  schema={schema}
>
  <article>
    <section class="hero post-hero">
      <div class="wrap">
        <p class="hero-eyebrow eyebrow">
          <a href="/blog/" class="back-link">The Green Room</a> · {post.data.kicker}
        </p>
        <h1>{post.data.title}</h1>
        <p class="hero-sub">{post.data.description}</p>

        <div class="byline">
          <span>By <strong>Steve Martin</strong> (the SEO one)</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{post.data.readingTime}</span>
        </div>

        <div class="share-bar" aria-label="Share this article">
          <span class="share-label">SHARE</span>

          <button
            class="share-btn copy-btn"
            id="share-copy"
            data-url={canonical}
            aria-label="Copy link"
            title="Copy link"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">
              <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/>
              <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>
            </svg>
            <span class="copy-label">Copy Link</span>
          </button>

          <a
            class="share-btn"
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on Facebook"
            title="Share on Facebook"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
            </svg>
            <span>Facebook</span>
          </a>

          <a
            class="share-btn"
            href={`https://x.com/intent/tweet?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(post.data.title)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on X"
            title="Share on X (Twitter)"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.261 5.632 5.903-5.632Zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>X</span>
          </a>

          <a
            class="share-btn"
            href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(canonical)}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on LinkedIn"
            title="Share on LinkedIn"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
              <rect x="2" y="9" width="4" height="12"/>
              <circle cx="4" cy="4" r="2"/>
            </svg>
            <span>LinkedIn</span>
          </a>
        </div>
      </div>
    </section>

    <script>
      const btn = document.getElementById('share-copy');
      if (btn) {
        btn.addEventListener('click', async () => {
          const url = btn.dataset.url ?? location.href;
          try {
            await navigator.clipboard.writeText(url);
          } catch {
            const ta = document.createElement('textarea');
            ta.value = url;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          const label = btn.querySelector('.copy-label');
          if (label) {
            label.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              label.textContent = 'Copy Link';
              btn.classList.remove('copied');
            }, 2000);
          }
        });
      }
    </script>

    <div class="bulb-strip" aria-hidden="true"></div>

    <section class="playbill post-layout">
      <div class="wrap">
        <div class="post-grid">
          <aside class="toc" aria-label="On this page">
            <p class="toc-title">Tonight's Set</p>
            <ol>
              {
                toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))
              }
            </ol>
          </aside>

          <div class="post-body">
            <Content />

            <div class="post-cta">
              <p class="eyebrow">Encore</p>
              <p>
                Want a second opinion on an audit somebody already sent you? I will read it and
                tell you which parts are real. Free, and it will not take 47 pages.
              </p>
              <a href="/contact" class="ticket-btn small">Send Me Your Audit →</a>
            </div>

            <div class="tags">
              {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <section class="cta-band">
    <div class="wrap">
      <span class="eyebrow">Next Show</span>
      <h2>More from the green room.</h2>
      <p>Plain-English notes on SEO, AI search, and websites that load before customers leave.</p>
      <a href="/blog/" class="ticket-btn">Back To The Green Room →</a>
    </div>
  </section>
</BaseLayout>

<style>
  .post-hero h1 {
    font-size: clamp(38px, 6vw, 68px);
    max-width: 22ch;
    line-height: 0.95;
  }
  .back-link {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 2px solid var(--border);
    font-weight: 700;
  }
  .byline {
    margin-top: 24px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .byline strong {
    color: var(--ink);
  }

  /* ---- Share Bar ---- */
  .share-bar {
    margin-top: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .share-label {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.2em;
    color: var(--ink-muted);
    margin-right: 4px;
  }
  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    background: var(--bg);
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0 var(--border);
    padding: 6px 12px;
    cursor: pointer;
    transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .share-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 4px 4px 0 var(--border);
  }
  .share-btn:active {
    transform: translate(0, 0);
    box-shadow: none;
  }
  .share-btn.copied {
    background: var(--surface-dark);
    color: var(--text-inverse);
    border-color: var(--surface-dark);
    box-shadow: 2px 2px 0 var(--border);
  }

  .post-grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .post-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }

  .toc {
    position: sticky;
    top: 90px;
    border-left: 2px solid var(--border);
    padding-left: 16px;
  }
  @media (max-width: 900px) {
    .toc {
      position: static;
      background: var(--bg-subtle);
      border: 2px solid var(--border);
      box-shadow: var(--shadow-brutal);
      padding: 18px 20px;
    }
  }
  .toc-title {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink);
    margin-bottom: 12px;
  }
  .toc ol {
    list-style: none;
    counter-reset: toc;
  }
  .toc li {
    counter-increment: toc;
    margin-bottom: 10px;
    font-size: 13.5px;
    line-height: 1.4;
  }
  .toc li::before {
    content: counter(toc, decimal-leading-zero) ' ';
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    color: var(--ink-muted);
  }
  .toc a {
    text-decoration: none;
    color: var(--ink-soft);
    border-bottom: 1px solid transparent;
  }
  .toc a:hover,
  .toc a:focus-visible {
    color: var(--ink);
    border-color: var(--border);
    outline: none;
  }

  /* ---- article typography ---- */
  .post-body {
    max-width: 68ch;
  }
  .post-body :global(p) {
    margin-top: 0;
    margin-bottom: 22px;
    font-size: 18.5px;
    line-height: 1.85;
    color: var(--ink-soft);
  }
  .post-body :global(p:first-child) {
    font-size: 21px;
    color: var(--ink);
    line-height: 1.7;
    margin-bottom: 28px;
  }
  .post-body :global(h2) {
    margin-top: 48px;
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1;
    scroll-margin-top: 90px;
  }
  .post-body :global(h2::before) {
    content: '■ ';
    font-size: 12px;
    vertical-align: middle;
  }
  .post-body :global(h3) {
    margin-top: 36px;
    font-size: 24px;
    line-height: 1.05;
    scroll-margin-top: 90px;
  }
  .post-body :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }
  .post-body :global(em) {
    font-style: italic;
  }
  .post-body :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    font-weight: 600;
  }
  .post-body :global(ul),
  .post-body :global(ol) {
    margin-top: 18px;
    padding-left: 4px;
    list-style-position: inside;
  }
  .post-body :global(li) {
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-soft);
    padding: 8px 0;
    border-bottom: 1px solid var(--border-subtle);
  }
  .post-body :global(li:last-child) {
    border-bottom: none;
  }
  .post-body :global(ul li::marker) {
    content: '■  ';
    font-size: 8px;
  }
  .post-body :global(ol li::marker) {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 700;
  }
  .post-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
  }
  .post-body :global(hr) {
    margin: 40px 0;
    border: none;
    border-top: 2px solid var(--border);
  }
  .post-body :global(blockquote) {
    margin-top: 24px;
    padding: 8px 0 8px 20px;
    border-left: 3px solid var(--border);
    font-size: 17.5px;
    color: var(--ink);
  }

  .post-cta {
    margin-top: 48px;
    background: var(--surface-dark);
    color: var(--text-inverse);
    border: 2px solid var(--border);
    box-shadow: var(--shadow-brutal);
    padding: 28px 24px;
  }
  .post-cta .eyebrow {
    color: var(--text-inverse-muted);
  }
  .post-cta p {
    margin-top: 10px;
    margin-bottom: 20px;
    color: var(--text-inverse-muted);
    font-size: 15.5px;
    line-height: 1.55;
  }
  .post-cta .ticket-btn {
    background: var(--bg);
    color: var(--ink);
  }

  .tags {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tag {
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 2px solid var(--border);
    box-shadow: 2px 2px 0 var(--border);
    padding: 5px 10px;
    color: var(--ink);
    background: var(--bg);
  }
</style>
