---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout
  title="Book A Free Audit: Contact Steve Martin | Wild & Crazy SEO"
  description="Free 20-minute consult and a real SEO audit for your small business. No contracts, no account managers, no automated PDF with a red gauge on it."
>
  <section class="hero">
    <div class="wrap">
      <div class="ribbon">
        <strong>Box Office</strong>
        Walk-ups welcome · Two-drink minimum waived
      </div>
      <p class="hero-eyebrow eyebrow">Reserve Your Seat</p>
      <h1>Let's book<br /><span class="accent">the show.</span></h1>
      <p class="hero-sub">
        Free 20-minute consult, a real look at your site, and an honest answer about whether
        you need me at all <em>(sometimes you don't, and I'll say so)</em>.
      </p>
    </div>
  </section>

  <div class="bulb-strip" aria-hidden="true"></div>

  <section class="playbill">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The Booking Form</p>
        <h2>Tell me what's not working.</h2>
        <p>
          The more specific you are, the more useful the first call is. "Our phone stopped
          ringing in March" is a better brief than "we need SEO."
        </p>
      </div>

      <!--
        Delivered via Resend API endpoint (/api/contact).
      -->
      <form
        id="booking-form"
        class="form-grid reveal"
        method="POST"
        action="/api/contact"
      >
        <!-- Honeypot: bots fill this, humans never see it. -->
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="honeypot" />
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>

        <div class="field">
          <label for="business">Business name</label>
          <input id="business" name="business" type="text" required autocomplete="organization" />
        </div>

        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>

        <div class="field">
          <label for="website">Current website</label>
          <input id="website" name="website" type="url" placeholder="https://" />
          <p class="hint">If you don't have one, that's a valid answer and a good starting point.</p>
        </div>

        <div class="field full">
          <label for="act">Which act are you interested in?</label>
          <select id="act" name="act">
            <option>Not sure yet: help me figure it out</option>
            <option>The Jerk: technical audit</option>
            <option>Roxanne: keyword research &amp; content</option>
            <option>L.A. Story: local SEO &amp; map pack</option>
            <option>The Man with Two Brains: AI search visibility</option>
            <option>Dirty Rotten Scoundrels: competitor teardown</option>
            <option>Planes, Trains and Automobiles: rebuild or migration</option>
            <option>Bowfinger: small budget, big ambition</option>
            <option>Father of the Bride: full service</option>
          </select>
        </div>

        <div class="field full">
          <label for="message">What's going on?</label>
          <textarea
            id="message"
            name="message"
            required
            placeholder="Where the phone stopped ringing, who's outranking you, what your last agency promised…"></textarea>
        </div>

        <div class="field full">
          <div id="form-error" class="form-error" role="alert" style="display: none; margin-bottom: 1rem; padding: 0.75rem 1rem; background: #fff1f0; border: 2px solid #c9382b; color: #a82216; font-size: 0.9rem;"></div>
          <button type="submit" id="submit-btn" class="ticket-btn">Send It →</button>
          <p class="hint" style="margin-top:14px;">
            I answer everything within one business day. If I'm full, I'll tell you that instead
            of stringing you along for three weeks.
          </p>
        </div>
      </form>

      <script>
        const form = document.getElementById('booking-form') as HTMLFormElement | null;
        const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;
        const errorBox = document.getElementById('form-error') as HTMLDivElement | null;

        if (form && submitBtn && errorBox) {
          form.addEventListener('submit', async (e) => {
            e.preventDefault();
            errorBox.style.display = 'none';
            const originalBtnText = submitBtn.innerText;
            submitBtn.innerText = 'Sending…';
            submitBtn.disabled = true;

            try {
              const formData = new FormData(form);
              const data: Record<string, string> = {};
              formData.forEach((value, key) => {
                data[key] = value.toString();
              });

              const response = await fetch('/api/contact', {
                method: 'POST',
                headers: {
                  'Content-Type': 'application/json',
                },
                body: JSON.stringify(data),
              });

              if (response.ok) {
                window.location.href = '/thanks/';
              } else {
                const resJson = await response.json().catch(() => ({}));
                errorBox.textContent = resJson.error || 'Something went wrong sending your message. Please try again or email directly.';
                errorBox.style.display = 'block';
                submitBtn.innerText = originalBtnText;
                submitBtn.disabled = false;
              }
            } catch (err) {
              console.error(err);
              errorBox.textContent = 'Network error. Please check your connection or email directly.';
              errorBox.style.display = 'block';
              submitBtn.innerText = originalBtnText;
              submitBtn.disabled = false;
            }
          });
        }
      </script>

      <style>
        .honeypot {
          position: absolute;
          left: -9999px;
          width: 1px;
          height: 1px;
          opacity: 0;
          pointer-events: none;
        }
      </style>
    </div>
  </section>

  <div class="bulb-strip dark" aria-hidden="true"></div>

  <section class="playbill">
    <div class="wrap">
      <div class="section-head center">
        <p class="eyebrow">Or Skip The Form</p>
        <h2>Stage door's open.</h2>
        <p>
          <!-- PLACEHOLDER contact details: swap in data/site.ts -->
          Email <a href={`mailto:${site.email}`} class="text-link">{site.email}</a><br /><br />
          Call or text <a href={`tel:${site.phoneHref}`} class="text-link">{site.phone}</a><br /><br />
          {site.location}
        </p>
      </div>
    </div>
  </section>

  <section class="cta-band" style="padding-top:0;">
    <div class="wrap">
      <p class="fine-print" style="margin-left:auto;margin-right:auto;text-align:center;">
        Still not affiliated with the comedian. He does not take these calls either.
      </p>
    </div>
  </section>
</BaseLayout>
